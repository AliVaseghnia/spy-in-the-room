# Non-secret template only. Copy these names into a protected local/Preview/
# Production environment; do not put real credentials in this file.

# Use a disposable/local Postgres database for local development.
DATABASE_URL=postgres://user:password@localhost:5432/spy_local_disposable

# Replace this placeholder with: openssl rand -base64 32
SESSION_SECRET=replace-with-openssl-rand-base64-32-output

# One exact origin is accepted for each environment.
APP_ORIGIN=http://localhost:3000

# Required in Preview/Production to authorize the scheduled cleanup function.
# Vercel sends this value as: Authorization: Bearer <secret>
CRON_SECRET=replace-with-openssl-rand-base64-32-output
